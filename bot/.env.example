# Copy this file and name the copy .env, then paste your values after the = signs.
# Never share .env or commit it. Git already ignores it.

# Orion's secret token, from the Discord Developer Portal (Bot page, Reset Token).
DISCORD_TOKEN=

# Your server's ID (right-click the server icon, Copy Server ID).
GUILD_ID=

# true = Orion only writes in the terminal what it would do. Nothing on the server changes.
DRY_RUN=false

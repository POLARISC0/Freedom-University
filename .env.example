# The game's SQLite database file, relative to the project root. Nothing to sign up for:
# `npx prisma migrate deploy` creates the file.
DATABASE_URL="file:./dev.db"

# Anthropic API key for the mentors' conversations. Create one at https://platform.claude.com/settings/keys
# Optional: without it the game and lessons still work, and only the conversations are switched off.
ANTHROPIC_API_KEY=""

# The Claude model the mentors use. claude-sonnet-5-5 is a cheaper alternative.
# Model names are listed in Anthropic's docs: https://platform.claude.com/docs
ANTHROPIC_MODEL="claude-opus-5-5"

// Walk With Him data model. Game content (characters, lessons, paths, verses) lives in src/walk/content as typed
// code; the database stores accounts and everything that belongs to a player.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  // scrypt hash (see src/lib/password.ts).
  passwordHash String
  createdAt    DateTime @default(now())

  sessions     Session[]
  walkProgress WalkLessonProgress[]
  journal      WalkJournalEntry[]
  walkMessages WalkMessage[]
  checkIns     WalkCheckIn[]
  walkLife     WalkLife?
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the random token stored in the cookie; the raw token never hits the DB.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WalkLessonProgress {
  id                  String    @id @default(cuid())
  userId              String
  lessonSlug          String
  pathSlug            String
  // Index of the step the player is on. Equals the number of steps once the lesson is complete.
  stepIndex           Int       @default(0)
  // "IN_PROGRESS" or "COMPLETED". Stays COMPLETED if the player replays the lesson.
  status              String    @default("IN_PROGRESS")
  // Options picked in "choice" steps, keyed by step index: { "4": "father" }.
  choices             Json?
  challengeAcceptedAt DateTime?
  // The player says they did the week's challenge.
  challengeDoneAt     DateTime?
  startedAt           DateTime  @default(now())
  completedAt         DateTime?
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonSlug])
  @@index([userId])
}

model WalkJournalEntry {
  id         String   @id @default(cuid())
  userId     String
  // "reflection" | "prayer" | "gratitude" | "note"
  kind       String
  title      String?
  body       String
  // Set for reflections written during a lesson.
  lessonSlug String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model WalkMessage {
  id          String   @id @default(cuid())
  userId      String
  characterId String
  // The lesson slug for conversations inside a lesson, "talk" for conversations outside one.
  thread      String
  role        String // "user" | "assistant"
  content     String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, characterId, thread, createdAt])
  @@index([userId, createdAt])
}

model WalkCheckIn {
  id        String   @id @default(cuid())
  userId    String
  // The player's local calendar date, YYYY-MM-DD.
  day       String
  mood      String
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}

model WalkLife {
  userId    String   @id
  // The player's character and life in the world (name, appearance, needs, friendships, badges) as one JSON
  // document. It is read and written only through parseLife (src/walk/life/state.ts), which trusts nothing in it.
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

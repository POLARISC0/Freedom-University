// Freedom University data model.
// Curriculum (professors, modules, objectives) lives in src/content as typed code;
// the database stores everything that belongs to a student plus cached news.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  createdAt DateTime @default(now())

  sessions     Session[]
  progress     ModuleProgress[]
  quizAttempts QuizAttempt[]
  messages     ChatMessage[]
}

model Session {
  id        String   @id @default(cuid())
  // SHA-256 of the random token stored in the cookie; the raw token never hits the DB.
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ModuleProgress {
  id            String    @id @default(cuid())
  userId        String
  professorSlug String
  moduleSlug    String
  // "IN_PROGRESS" once the student opens the module, "COMPLETED" after passing its quiz.
  status        String    @default("IN_PROGRESS")
  bestScore     Int       @default(0) // percent, 0-100
  attempts      Int       @default(0)
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, professorSlug, moduleSlug])
  @@index([userId])
}

model QuizAttempt {
  id            String    @id @default(cuid())
  userId        String
  professorSlug String
  moduleSlug    String
  // Generated quiz including the answer key. Only the server ever reads the key.
  quiz          Json
  // Student answers and per-question grading, filled in on submission.
  answers       Json?
  grading       Json?
  score         Int? // percent, 0-100
  passed        Boolean?
  createdAt     DateTime  @default(now())
  submittedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, professorSlug, moduleSlug])
}

model ChatMessage {
  id            String   @id @default(cuid())
  userId        String
  professorSlug String
  moduleSlug    String
  role          String // "user" | "assistant"
  content       String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, professorSlug, moduleSlug, createdAt])
}

model NewsBriefing {
  id        String   @id @default(cuid())
  // Calendar day in UTC, YYYY-MM-DD. One briefing per day, regenerated on demand.
  day       String   @unique
  headlines Json
  summary   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
